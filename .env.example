# NeoContract: example values only; no credentials.
# The application does NOT automatically load .env files.
# Set variables in the process environment; see docs/OPERATIONS.md.

# App binds to 127.0.0.1. Default: 4173.
PORT=4173

# Bind address. Keep 127.0.0.1 for local use; containers use 0.0.0.0.
HOST=127.0.0.1

# PGlite directory, relative to the working directory; default: .data/postgres.
# Use a separate directory per running process. memory:// is temporary.
NEOCONTRACT_DATA_DIR=.data/postgres

# Optional external PostgreSQL connection string. Takes precedence over data dir.
# Leave empty for local PGlite. Supply real credentials outside this repository.
NEOCONTRACT_DATABASE_URL=

# local-demo | authenticated | oidc-proxy
NEOCONTRACT_AUTH_MODE=local-demo

# Normal startup separates the historical demo into four customer workspaces.
# false is for the legacy regression fixture; it cannot undo an existing import.
NEOCONTRACT_CUSTOMER_TENANTS=true
NEOCONTRACT_DEFAULT_TENANT=00000000-0000-0000-0000-000000000001

# Set true only when the app is reachable exclusively through the trusted SSO proxy.
NEOCONTRACT_TRUST_PROXY_AUTH=false

# Fanasa SSO values are deployment secrets/configuration, never commit real values.
FANASA_SSO_ISSUER=
FANASA_SSO_CLIENT_ID=
FANASA_SSO_CLIENT_SECRET=
FANASA_SSO_REDIRECT_URL=

# Required for non-loopback HTTPS Neo; project/URLs are in planning/neo-binding.json.
# Loopback Neo supports local development headers when this is empty.
NEO_API_TOKEN=

# Optional Neo orchestration chat identity. Preserve the host-provided value.
# When unset/empty, code uses neocontract-demo. Keep identity stable for retries.
# CODEX_THREAD_ID=

# Chrome used by Playwright and scripts/capture-ui.mjs; this is the code default.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Only scripts/capture-ui.mjs reads this; its default is 4174, not the app's 4173.
DEMO_URL=http://127.0.0.1:4174/
